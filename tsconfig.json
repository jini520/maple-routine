{
  // 저장소 루트가 곧 Expo 프로젝트라, 검사할 파일을 이 파일이 직접 `include` 한다.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    // `src/types/image-asset.native.ts` 처럼 RN 에서만 갈리는 파일을 tsc 가 고르게 한다.
    "moduleSuffixes": [".native", ""],
    "types": ["jest", "expo/types"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "nativewind-env.d.ts",
    "asset-modules.d.ts",
    "jest-extensions.d.ts"
  ],
  "exclude": ["node_modules"]
}
