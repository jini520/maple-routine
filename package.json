{
  "name": "maple-routine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @maple-routine/app-capacitor",
    "dev:beta": "npm run dev:beta -w @maple-routine/app-capacitor",
    "build": "npm run build -w @maple-routine/app-capacitor",
    "build:beta": "npm run build:beta -w @maple-routine/app-capacitor",
    "build:test-ads": "npm run build:test-ads -w @maple-routine/app-capacitor",
    "lint": "eslint .",
    "test": "vitest run && npm run test -w @maple-routine/app-rn",
    "preview": "npm run preview -w @maple-routine/app-capacitor",
    "publish-live-update": "node scripts/publish-live-update.mjs",
    "theme:gen": "vite-node scripts/theme-gen.ts",
    "assets:gen": "node scripts/generate-asset-manifest.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.7",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
