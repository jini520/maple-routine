{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "moduleSuffixes": [
      ".native",
      ""
    ],
    "types": [
      "jest",
      "expo/types"
    ],
    "paths": {
      "@core/*": [
        "../core/src/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "nativewind-env.d.ts",
    "asset-modules.d.ts"
  ]
}
