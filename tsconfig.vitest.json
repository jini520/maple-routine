{
  // vitest 가 도는 것들(`*.spec.*` · `ota/`)만 따로 검사한다([[ADR-155]] 결정 6).
  //
  // 갈리는 이유는 **하나**다 — 이쪽은 Vite 위에서 돌아 `import.meta.glob` 이 사실이고, 앱 프로그램에는
  // 그 선언이 없어야 한다(`tsconfig.json` 의 `exclude` 주석 · `vitest-import-meta.d.ts` 참고).
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "ota/**/*.ts",
    "vitest.setup.ts",
    "vitest-import-meta.d.ts",
    // 에셋 모듈 선언(`*.webp` → `ImageAsset`). 앱 프로그램과 **같은 선언**을 쓴다 — 종전 `vite/client`
    // 는 이것을 `string`(URL)이라 했고 RN 은 `number`(모듈 id)라, 둘을 섞으면 생성 목록이 빨개진다.
    "asset-modules.d.ts"
  ],
  "exclude": ["node_modules"]
}
