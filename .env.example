# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
#
# EXPO_PUBLIC_ 접두사가 붙은 값은 babel-preset-expo 가 번들에 그대로 박아 넣는다. 비밀이 아니라
# 빌드 설정이다. 앱을 뜯으면 누구나 볼 수 있다.
#
# ⚠️ Metro 트랜스폼 캐시는 이 값이 바뀌어도 무효화되지 않는다. 값을 바꿔서 빌드할 때는
#    --clear 또는 --reset-cache 를 같이 준다. 자세한 내용은 docs/features/ads.md.

# AdMob 전면광고 단위 ID. 비워 두면 광고가 나가지 않는다.
# AdMob 콘솔의 광고 단위에서 가져온다. 슬래시(/)가 들어간 값이다.
# Android 와 iOS 는 별개 앱으로 등록되므로 값이 서로 다르다.
EXPO_PUBLIC_ADS_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADS_INTERSTITIAL_IOS=

# 1 이면 실 광고 대신 Google 테스트 광고를 쓴다. 개발 클라이언트(__DEV__)는 이 값이 없어도
# 항상 테스트 광고를 쓴다.
EXPO_PUBLIC_ADS_TEST=

# OTA 채널. beta 면 테스트 광고를 쓴다. 베타 빌드는 스토어에 나가지 않기 때문이다.
EXPO_PUBLIC_LIVE_UPDATE_CHANNEL=
